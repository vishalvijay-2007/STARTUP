meta {
  name: Register
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/register
  body: json
  auth: none
}

body:json {
  {
    "name": "Bruno Student",
    "username": "brunostudent",
    "email": "bruno.student@example.com",
    "password": "password123"
  }
}

script:post-response {
  bru.setEnvVar("token", res.body.token)
  bru.setEnvVar("userId", res.body.user.id)
}