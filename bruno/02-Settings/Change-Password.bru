meta {
  name: Change Password
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/settings/change-password
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{authToken}}
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  {
    "currentPassword": "Password123!",
    "newPassword": "BrandNewSecurePassword123!"
  }
}

docs {
  # Change Password
  Change the account password by verifying current credentials.

  ### Authentication
  Bearer Token

  ### Allowed Roles
  - Founder
- Mentor
- Admin

  ### Request Body Fields
  - `currentPassword` (string, required) - Existing plaintext password for verification.
  - `newPassword` (string, required) - New password.

  ### Response Status Codes
  - `200` - Password changed successfully.
  - `400` - Current password verification failed.
  - `401` - Unauthorized.

  ### Response Example (200)
  ```json
  {
    "success": true,
    "message": "Password successfully changed."
  }
  ```
}
