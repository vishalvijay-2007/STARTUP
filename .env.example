# ==============================================================================
# Startup Incubation Platform - Environment Variables Template
# ==============================================================================
# Copy this file to .env and configure values before starting Docker Compose:
#   cp .env.example .env
#
# IMPORTANT SECURITY NOTICE:
# - NEVER commit your .env file or real production secrets to version control.
# - All sensitive credentials must be supplied at runtime via environment variables
#   or secret management services (Docker Secrets, GCP Secret Manager, Vault).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Networking
# ------------------------------------------------------------------------------
# The port the backend Express server listens on inside its container (default: 3000)
PORT=3000

# Node environment mode: 'production' or 'development'
NODE_ENV=production

# Public application URL used for self-referential links, email redirects, and OAuth
APP_URL=http://localhost:80

# Frontend API base URL (empty defaults to same-origin reverse-proxied /api)
VITE_API_BASE_URL=

# ------------------------------------------------------------------------------
# 2. Database & Persistent Storage Configuration
# ------------------------------------------------------------------------------
# Directory path for persistent database storage (in Docker: /app/data mounted to a volume)
DATA_DIR=/app/data

# Specific path to the database file (defaults to $DATA_DIR/db.json)
DB_FILE=/app/data/db.json

# ------------------------------------------------------------------------------
# 3. Google Gemini AI & Optional Secondary AI Provider Configuration
# ------------------------------------------------------------------------------
# Primary AI Provider: Google Gemini API key required for AI Startup Assistant, TAM/SAM sizing, and Course Recommendations
# Obtain your key from Google Cloud Console or Google AI Developer platform: https://ai.google.dev/
GEMINI_API_KEY=your_gemini_api_key_here

# Optional Secondary AI Provider Fallback (automatically engaged if Gemini reaches daily quota or is unavailable):
OPENAI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
SECONDARY_AI_API_KEY=
SECONDARY_AI_BASE_URL=
SECONDARY_AI_MODEL=
SECONDARY_AI_PROVIDER_NAME=

# ------------------------------------------------------------------------------
# 4. Authentication & Security
# ------------------------------------------------------------------------------
# Strong secret key used for signing session tokens and password verification hashes
# Generate a secure string: openssl rand -base64 32
JWT_SECRET=2cb2dc31f980d473b4b85708006f0c379dae7e0dffad7ba9870f85c6cfb668a2

# ------------------------------------------------------------------------------
# 5. Google OAuth 2.0 Web Client Configuration
# ------------------------------------------------------------------------------
# Google Cloud Console OAuth 2.0 Client ID for Google Single Sign-On (SSO)
# Configured in: Google Cloud Console -> APIs & Services -> Credentials
# Authorized JavaScript Origins: http://localhost:80 (or your custom domain)
VITE_GOOGLE_CLIENT_ID=667833433596-b03ie8ce9br6sgtq731ds9v2vb41b66v.apps.googleusercontent.com

# ------------------------------------------------------------------------------
# 6. Localization & Currency Standards
# ------------------------------------------------------------------------------
# Standard incubation currency: Indian Rupee (INR ₹)
DEFAULT_CURRENCY=INR
DEFAULT_LOCALE=en-IN
INCUBATOR_HQ_LOCATION="Chennai, Tamil Nadu, India"
